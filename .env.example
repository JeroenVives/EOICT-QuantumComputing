# Copy this file to `.env` and fill in your token.
# Get a token: https://www.ibm.com/account/registration/signin -> "Quantum Platform"
# -> "Resource List" -> "Add API token" (free tier account, no credit card).
#
# The course helper code reads QISKIT_IBM_TOKEN automatically when you use
# qclab.runner.run_on_ibm(). The token is ONLY used for the optional
# "run on real hardware" section; all regular exercises run on a local
# simulator and work without it.

QISKIT_IBM_TOKEN=
